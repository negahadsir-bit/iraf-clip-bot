03195, 27.66], ["خوش بگذرد فلان این‌ها", 27.66, 29.505977011494252], ["ولی ببین ما اولین چیز مثلث", 29.505977011494252, 32.02322048850574], ["اصلاً قبل از اینکه وارد مثلث مثلاً", 32.02322048850574, 34.79218390804598], ["چی بخواهیم بشویم محدودیت است", 34.79218390804598, 37.81287566091954], ["تا بخواهیم دانه‌دانه این‌ها را", 37.81287566091954, 39.171947547353085], ["بیاییم بالا برسیم به آن سطح", 39.171947547353085, 40.581839080459766], ["و این باعث می‌شود که این محدودیت", 40.581839080459766, 42.67], ["مثل یک حالت فنر جمع‌شده‌ای باشد", 42.67, 44.82298437844612], ["که یک‌دفعه‌ای قرار است مثلاً", 44.82298437844612, 46.82], ["ول کند خود خود را", 46.82, 47.591102756892234], ["و شما را به موفقیت پرتاب کند", 47.591102756892234, 49.474962406015045], ["به موفقیت برساند", 49.474962406015045, 50.333333]]}