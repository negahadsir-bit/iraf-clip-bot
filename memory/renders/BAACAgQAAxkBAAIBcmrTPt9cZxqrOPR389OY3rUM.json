 [[4.1, 3.98], [4.45, 4.68], [8.1, 8.32], [9.15, 8.81], [20.15, 21.18], [20.5, 21.57], [25.75, 25.48], [26.2, 25.71], [27.65, 28.72], [28.0, 29.0], [34.85, 35.22], [35.8, 35.6], [56.5, 56.48]], "schedule": [["دقیقاً به نظر خود من شخصاً خیلی", 0.0, 0.011250000000000343], ["از ما افغانستانی‌ها یکی از دلیل‌های", 0.011250000000000343, 2.18], ["موفقیت به نظر من محدودیته", 2.18, 4.68], ["یعنی وقتی که خیلی شرایط", 4.68, 6.973698630136987], ["به آدم سخت باشه مجبور", 6.973698630136987, 9.61], ["میشی به زیاد تلاش کردن", 9.61, 12.014954545454547], ["و اصلاً هیچی اصلاً نمیذاره خوفی", 12.014954545454547, 14.657636363636364], ["و فکرهایی که توی سرتونه که آقا", 14.657636363636364, 17.131636363636368], ["من باید خود خو از این حالت", 17.131636363636368, 19.380727272727277], ["اگه استیبل باشه همه‌چی", 19.380727272727277, 21.57], ["خب شاید مثلاً بری دنبال", 21.57, 22.687142857142856], ["یک آب‌باریکه‌ای که آقا زندگیم بچرخه", 22.687142857142856, 24.28838095238095], ["لذت‌ها خود رو داشته باشم", 24.28838095238095, 25.71], ["خوش بگذره فلان اینا", 25.71, 29.0], ["ولی برای ما اولین چیز مثلث", 29.0, 31.451678832116787], ["اصلاً قبل از این که وارد مثلث", 31.451678832116787, 33.47], ["مثلاً چی بخوایم بشیم محدودیته", 33.47, 35.6], ["تا بخوایم دونه دونه اینا رو", 35.6, 37.11304347826087], ["بیایم بالا و برسیم به اون سطح", 37.11304347826087, 38.87826086956522], ["و این باعث میشه که این محدودیته", 38.87826086956522, 40.89565217391304], ["مثل یک حالت فنر جمع‌شده‌ای", 40.89565217391304, 42.71130434782609], ["باشه که یک‌دفعه‌ای قراره مثلاً", 42.71130434782609, 44.88], ["ول کنه خود خو و شما را", 44.88, 46.44347826086957], ["به موفقیت پرتاب کنه به موفقیت برسونه", 46.44347826086957, 48.66260869565218], ["و باعث تلاش بیشتر", 48.66260869565218, 49.873043478260875], ["باعث جنب‌وجوش این‌در-اون‌در زدن", 49.873043478260875, 51.84], ["این که هر کاری مثلاً بکنی خیلی", 51.84, 54.26086956521739], ["سریع‌تر برسی به او چیزی که می‌خوای", 54.26086956521739, 56.473083]]}